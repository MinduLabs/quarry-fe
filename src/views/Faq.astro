---
import { type Lang, localePath, useT } from "@/i18n";
import Base from "@/layouts/Base.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);
const items = [
  ["q1", "a1"],
  ["q6", "a6"],
  ["q2", "a2"],
  ["q7", "a7"],
  ["q3", "a3"],
  ["q4", "a4"],
  ["q5", "a5"],
] as const;
---

<Base lang={lang} path="/faq" title={t("page.faq")} description={t("page.faq.desc")}>
  <section class="page-head grid-bg">
    <div class="wrap">
      <h1>{t("q.title")}</h1>
      <p set:html={t("q.sub", { contact: localePath(lang, "/contact") })} />
    </div>
  </section>
  <section class="narrow page-end">
    {items.map(([q, a]) => (
      <details><summary>{t(q)}</summary><div class="a"><p set:html={t(a)} /></div></details>
    ))}
  </section>
</Base>
