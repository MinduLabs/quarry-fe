---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "@/styles/global.css";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { type Lang, localePath, useT } from "@/i18n";
import { asset } from "@/lib/base";

interface Props {
  lang: Lang;
  /** The page's path without the language prefix, e.g. "/download". */
  path: string;
  title: string;
  description?: string;
  /** schema.org data for this page, rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}

const { lang, path, title, description, jsonLd } = Astro.props;
const t = useT(lang);
const site = Astro.site ?? new URL("https://example.com");
const url = (l: Lang) => new URL(localePath(l, path), site).href;
const desc = description ?? t("meta.description");
const ogImage = new URL(asset("/og.jpg"), site).href;
const ogLocale = { en: "en_US", vi: "vi_VN" } as const;
---

<!doctype html>
<html lang={lang} data-theme="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={url(lang)} />
    <link rel="alternate" hreflang="en" href={url("en")} />
    <link rel="alternate" hreflang="vi" href={url("vi")} />
    <link rel="alternate" hreflang="x-default" href={url("en")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Quarry" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[lang === "en" ? "vi" : "en"]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t("home.heroAlt")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0b0b0c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <link rel="sitemap" href={asset("/sitemap-index.xml")} />
    <link rel="icon" type="image/png" href={asset("/favicon.png")} />
    <link rel="apple-touch-icon" href={asset("/apple-touch-icon.png")} />
    <!-- Before first paint, so a saved theme never flashes the other one. -->
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        const t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <Header lang={lang} path={path} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script>
      import "@/scripts/site";
    </script>
  </body>
</html>
