---
import { type Lang, localePath, otherLang, useT } from "@/i18n";
import { LINKS } from "@/lib/site";

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useT(lang);
const to = (p: string) => localePath(lang, p);
const current = (p: string) => (p === path ? "page" : undefined);
---

<header class="nav">
  <div class="wrap">
    <a class="brand" href={to("/")}><img src="/img/logo.webp" alt="" width="26" height="26" />Quarry</a>
    <nav class="nav-links">
      <a href={`${to("/")}#features`}>{t("nav.features")}</a>
      <a href={to("/download")} aria-current={current("/download")}>{t("nav.download")}</a>
      <a href={to("/faq")} aria-current={current("/faq")}>{t("nav.faq")}</a>
      <a href={LINKS.changelog}>{t("nav.changelog")}</a>
      <a href={to("/contact")} aria-current={current("/contact")}>{t("nav.contact")}</a>
    </nav>
    <div class="nav-end">
      <a class="chip" href={LINKS.repo} aria-label="GitHub">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path></svg>
      </a>
      <a class="chip" href={localePath(otherLang(lang), path)} hreflang={otherLang(lang)} lang={otherLang(lang)} title={t("nav.language")}>
        {otherLang(lang).toUpperCase()}
      </a>
      <button class="chip" id="theme" type="button" aria-label={t("nav.theme")}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path></svg>
      </button>
      <a class="btn btn-primary btn-sm" href={to("/download")}>{t("nav.download")}</a>
    </div>
  </div>
</header>
